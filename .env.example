ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password
JWT_SECRET=long-random-string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0....mongodb.net/loan-db?retryWrites=true&w=majority

# OpenRouteService — geocode + directions for auto quote (server-only)
ORS_API_KEY=

# Pricing Engine v2 (admin calculator + booking "Tính tự động" when true)
# Customer public booking stays on legacy quote until a later phase.
PRICING_ENGINE_V2=false

# Ably — realtime signals for ride admin (server-only)
ABLY_API_KEY=

# Cloudinary — signed image upload / destroy (server-only; never expose API_SECRET)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site origin for ride SEO (canonical, sitemap, Open Graph) — no trailing slash
# Production: use the canonical host (www). Must match Vercel Domains primary.
VITE_SITE_URL=https://www.chauthai.id.vn

# Optional GA4 for /ride public pages only
VITE_GA_MEASUREMENT_ID=

# PNJ gold price feed (server-only; never call from browser)
PNJ_ZONE=00
GOLD_PRICE_SYNC_SECRET=long-random-sync-secret
# Optional cache TTL ms (default 600000 = 10 minutes)
# GOLD_PRICE_CACHE_TTL_MS=600000

# PVOIL fuel price sync (server-only; never call from browser)
# Optional User-Agent for PVOIL requests
FUEL_PRICE_SYNC_SECRET=long-random-fuel-sync-secret
PVOIL_USER_AGENT=Mozilla/5.0 ...
PVOIL_ORIGIN_IP=103.21.120.100
PVOIL_ORIGIN_TIMEOUT_MS=5000
PVOIL_TIMEOUT_MS=12000
# Origin IP bypass Cloudflare DNS (comma-separated). Set to "off" to disable.
# Timeouts (ms). Origin defaults shorter so Vercel can fail over before function kill.

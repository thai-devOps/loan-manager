ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password
JWT_SECRET=long-random-string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0....mongodb.net/loan-db?retryWrites=true&w=majority

# OpenRouteService — geocode + directions for auto quote (server-only)
ORS_API_KEY=

# Ably — realtime signals for ride admin (server-only)
ABLY_API_KEY=

# Cloudinary — signed image upload / destroy (server-only; never expose API_SECRET)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site origin for ride SEO (canonical, sitemap, Open Graph) — no trailing slash
# Production: use the canonical host (www). Must match Vercel Domains primary.
VITE_SITE_URL=https://www.chauthai.id.vn

# Optional GA4 for /ride public pages only
VITE_GA_MEASUREMENT_ID=

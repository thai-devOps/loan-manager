# Copy to .env and fill in values. Do not commit .env.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password
JWT_SECRET=long-random-string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0....mongodb.net/loan-db?retryWrites=true&w=majority

# OpenRouteService — geocode + directions (server-only)
ORS_API_KEY=your-ors-api-key

# Ably — ride admin realtime (server-only)
ABLY_API_KEY=your-ably-api-key

# Public site URL for SEO canonical + sitemap (no trailing slash)
# Example: https://your-domain.com
VITE_SITE_URL=

# Optional Google Analytics 4 measurement ID (ride public site only)
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
